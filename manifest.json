{
  "manifest_version": 3,
  "name": "Claude Token Tracker",
  "version": "1.2.0",
  "description": "Shows context window fill on claude.ai. Tracks tokens, not message quota.",

  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://claude.ai/*"],

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Token Tracker",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://claude.ai/*"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "claude-token-tracker@extension",
      "strict_min_version": "128.0"
    }
  }
}
