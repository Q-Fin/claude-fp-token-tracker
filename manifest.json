{
  "manifest_version": 3,
  "name": "Claude Token Tracker",
  "version": "1.1.0",
  "description": "Shows context window usage on claude.ai",

  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://claude.ai/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Token Tracker"
  },

  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://claude.ai/*"]
    }
  ]
}
